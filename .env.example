# Copy these settings into the environment, or into a file outside git and
# outside the web root. See docs/installation.md.
# Leave the required values blank here. The application will not start until
# they are set, and it does not ship with fallback credentials.

# Required
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Optional
DB_CHARSET=utf8mb4
APP_NAME=EasyCalf
APP_VERSION=1.0
BASE_URL=
UPLOAD_PATH=

# Keep this false on any server that other people can reach.
# Debug and migration routes stay closed unless this is true.
APP_DEBUG=false

# Optional. Leave disabled unless you intentionally want open access.
PUBLIC_ACCESS_ENABLED=false
PUBLIC_ACCESS_CODE=
